    ],
    "procedure_args": {
      "options": {
        "target-file-size-bytes": 536870912,
        "min-input-files": 2,
        "partial-progress.enabled": true
      }
    }
  },
  "compaction_evolved_spec": {
    "where": [
      "(`region` = 'eu')",
      "(`iceberg`.system.days(`ts`) = DATE '2025-10-23' AND `ts` >= TIMESTAMP '2025-10-23 00:00:00.000000+00:00' AND `ts` < TIMESTAMP '2025-10-24 00:00:00.000000+00:00') OR (`iceberg`.system.days(`ts`) = DATE '2025-10-24' AND `ts` >= TIMESTAMP '2025-10-24 00:00:00.000000+00:00' AND `ts` < TIMESTAMP '2025-10-25 00:00:00.000000+00:00')"
