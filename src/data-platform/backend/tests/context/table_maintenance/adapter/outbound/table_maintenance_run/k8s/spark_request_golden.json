    "procedure_args": {
      "options": {
        "target-file-size-bytes": 536870912,
        "min-input-files": 2,
        "partial-progress.enabled": true
      }
    }
  },
  "compaction_month_year_hour": {
    "where": [
      "(`iceberg`.system.months(`d`) = 681 AND `d` >= DATE '2026-10-01' AND `d` < DATE '2026-11-01' AND `iceberg`.system.years(`y`) = 56 AND `y` >= DATE '2026-01-01' AND `y` < DATE '2027-01-01' AND `iceberg`.system.hours(`t`) = 489240 AND `t` >= TIMESTAMP_NTZ '2025-10-24 00:00:00.000000' AND `t` < TIMESTAMP_NTZ '2025-10-24 01:00:00.000000')"
    ],
    "procedure_args": {
      "options": {
        "target-file-size-bytes": 536870912,
        "min-input-files": 2,
        "partial-progress.enabled": true
      }
    }
  },
  "compaction_scalar_values_and_null": {
    "where": [
      "(`iceberg`.system.truncate(4, `name`) = 'abcd' AND `flag` = true AND `price` = 12.50 AND `score` = 1.5 AND `seq` = 9000000000 AND `note` IS NULL)"
    ],
    "procedure_args": {
      "options": {
        "target-file-size-bytes": 536870912,
        "min-input-files": 2,
        "partial-progress.enabled": true
      }
    }
  },
  "compaction_nested_column_and_backtick_catalog": {
    "where": [
      "(`a`.`b` = 3 AND `ice``berg`.system.bucket(4, `a`.`c`) = 1)"
