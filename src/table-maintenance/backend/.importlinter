[importlinter]
root_packages =
    adapter
    application
    base
    bootstrap
include_external_packages = True

[importlinter:contract:domain-core-isolation]
name = Domain core (entities, value objects) does not depend on application or adapter
type = forbidden
source_modules =
    application.domain.model
forbidden_modules =
    application.port
    application.exceptions
    application.service
    application.domain.service
    adapter
    bootstrap
    fastapi
    kubernetes
    temporalio
    pyiceberg
    pyarrow
    sqlalchemy

[importlinter:contract:application-isolation]
name = Application does not depend on adapter or bootstrap
type = forbidden
source_modules =
    application
forbidden_modules =
    adapter
    bootstrap
    fastapi
    kubernetes
    temporalio
    pyiceberg
    pyarrow
    sqlalchemy

[importlinter:contract:clean-architecture-layers]
name = Clean Architecture layer ordering
type = layers
layers =
    adapter.inbound.web | adapter.inbound.temporal | adapter.inbound.event_consumer
    application.service
    application.port
    application.domain.model

[importlinter:contract:temporal-contracts-neutral]
name = Temporal contracts depend only on stdlib and the shared domain model
type = forbidden
source_modules =
    adapter.temporal_contracts
forbidden_modules =
    application
    base
    adapter.inbound
    adapter.outbound
    bootstrap
    temporalio
    fastapi
    kubernetes
    pyiceberg
    pyarrow
    sqlalchemy
unmatched_ignore_imports_alerting = none
ignore_imports =
    adapter.temporal_contracts.** -> application.domain.model.shared.**

[importlinter:contract:temporal-workflows-sandbox-safe]
name = Temporal workflows import only contracts and the domain model (sandbox-safe)
type = forbidden
source_modules =
    adapter.inbound.temporal.workflows
forbidden_modules =
    application.port
    application.service
    application.exceptions
    application.domain.service
    application.domain.model.table_discovery_settings
    application.domain.model.table_discovery_rule
    application.domain.model.table_maintenance_run
    application.domain.model.table
    application.domain.model.table_maintenance_preset
    adapter.inbound.temporal.activities
    adapter.inbound.web
    adapter.inbound.event_consumer
    adapter.outbound
    bootstrap
    fastapi
    kubernetes
    pyiceberg
    pyarrow
    sqlalchemy

[importlinter:contract:inbound-outbound-separation]
name = Inbound adapter does not directly import outbound adapter
type = forbidden
source_modules =
    adapter.inbound
forbidden_modules =
    adapter.outbound

[importlinter:contract:outbound-inbound-separation]
name = Outbound adapter does not depend on inbound adapter
type = forbidden
source_modules =
    adapter.outbound
forbidden_modules =
    adapter.inbound

[importlinter:contract:configs-leaf]
name = Configs does not depend on bounded contexts
type = forbidden
source_modules =
    bootstrap.configs
forbidden_modules =
    adapter
    application

[importlinter:contract:base-isolation]
name = Base (DDD kernel) depends on nothing project-internal
type = forbidden
source_modules =
    base
forbidden_modules =
    application
    adapter
    bootstrap

[importlinter:contract:service-isolation]
name = Application service does not depend on adapter or framework
type = forbidden
source_modules =
    application.service
forbidden_modules =
    adapter
    bootstrap
    fastapi
    kubernetes
    temporalio
    pyiceberg
    pyarrow
    sqlalchemy

[importlinter:contract:adapter-no-bootstrap]
name = Adapters do not depend on bootstrap (the composition root depends on them)
type = forbidden
source_modules =
    adapter
forbidden_modules =
    bootstrap

[importlinter:contract:inbound-web-no-bootstrap]
name = Inbound web adapter does not depend on bootstrap (use cases are injected)
type = forbidden
source_modules =
    adapter.inbound.web
forbidden_modules =
    bootstrap

[importlinter:contract:inbound-adapter-independence]
name = Inbound adapters are independent of each other
type = independence
modules =
    adapter.inbound.web
    adapter.inbound.temporal
    adapter.inbound.event_consumer

[importlinter:contract:inbound-event-consumer-no-bootstrap]
name = Inbound event consumer does not depend on bootstrap or the domain (use cases are injected)
type = forbidden
source_modules =
    adapter.inbound.event_consumer
forbidden_modules =
    bootstrap
    application.domain
    application.service
