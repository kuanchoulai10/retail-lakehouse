[importlinter]
root_packages =
    adapter
    application
    base
    bootstrap
include_external_packages = True

[importlinter:contract:domain-pure]
name = Domain depends only on base and the stdlib
type = forbidden
source_modules =
    application.domain
forbidden_modules =
    application.port
    application.service
    application.exceptions
    adapter
    bootstrap
    temporalio
    pyiceberg
    pyarrow
    sqlalchemy
    fastapi
    kubernetes
    confluent_kafka
    pydantic

[importlinter:contract:application-ring-order]
name = Application ring order: service, port, domain service, domain model
type = layers
layers =
    application.service
    application.port
    application.domain.service
    application.domain.model

[importlinter:contract:application-no-outer-rings]
name = Application does not depend on adapters, bootstrap or frameworks
type = forbidden
source_modules =
    application
forbidden_modules =
    adapter
    bootstrap
    temporalio
    pyiceberg
    pyarrow
    sqlalchemy
    fastapi
    kubernetes
    confluent_kafka
    pydantic

[importlinter:contract:adapters-see-only-ports]
name = Adapters import application only through ports and exceptions
type = forbidden
source_modules =
    adapter
forbidden_modules =
    application.domain
    application.service
allow_indirect_imports = true

[importlinter:contract:adapter-directions-separate]
name = Inbound, outbound and hybrid adapters are independent
type = independence
modules =
    adapter.inbound
    adapter.outbound
    adapter.hybrid

[importlinter:contract:hybrid-directions-separate]
name = Hybrid inbound and outbound adapters are independent
type = independence
modules =
    adapter.hybrid.temporal.inbound
    adapter.hybrid.temporal.outbound

[importlinter:contract:hybrid-contracts-neutral]
name = Hybrid contracts depend only on the stdlib, base and ports
type = forbidden
source_modules =
    adapter.hybrid.temporal.contracts
forbidden_modules =
    application.domain
    application.service
    adapter.inbound
    adapter.outbound
    adapter.hybrid.temporal.inbound
    adapter.hybrid.temporal.outbound
    bootstrap
    temporalio
    pyiceberg
    pyarrow
    sqlalchemy
    fastapi
    kubernetes
    confluent_kafka
    pydantic

[importlinter:contract:hybrid-contracts-private]
name = Hybrid contracts are private to their technology
type = forbidden
source_modules =
    adapter.inbound
    adapter.outbound
    application
forbidden_modules =
    adapter.hybrid.temporal.contracts

[importlinter:contract:temporal-workflows-sandbox-safe]
name = Temporal workflows import only Temporal and their contracts (sandbox-safe)
type = forbidden
source_modules =
    adapter.hybrid.temporal.inbound.workflows
forbidden_modules =
    application
    adapter.hybrid.temporal.inbound.activities
    adapter.inbound
    adapter.outbound
    adapter.hybrid.temporal.outbound
    bootstrap
    pyiceberg
    pyarrow
    sqlalchemy
    fastapi
    kubernetes
    confluent_kafka
    pydantic

[importlinter:contract:inbound-channels-independent]
name = Inbound channels are independent of each other
type = independence
modules =
    adapter.inbound.web
    adapter.inbound.event_consumer
    adapter.hybrid.temporal.inbound

[importlinter:contract:adapters-no-bootstrap]
name = Adapters do not depend on bootstrap (the composition root depends on them)
type = forbidden
source_modules =
    adapter
forbidden_modules =
    bootstrap

[importlinter:contract:configs-leaf]
name = Configs does not depend on bounded contexts
type = forbidden
source_modules =
    bootstrap.configs
forbidden_modules =
    adapter
    application

[importlinter:contract:base-isolation]
name = Base (DDD kernel) depends on nothing project-internal
type = forbidden
source_modules =
    base
forbidden_modules =
    application
    adapter
    bootstrap
