        "",
        "DEBUG",
        "INFO",
        "WARNING",
        "ERROR",
        "CRITICAL"
      ]
    },
    "url": {
      "type": "string",
      "pattern": "^(|https?://\\S+)$"
    },
    "hostPort": {
      "type": "string",
      "pattern": "^(|[^\\s:/,]+:[0-9]+)$"
